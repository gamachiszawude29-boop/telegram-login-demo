
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#ffffff">
<title>Telegram Login - Security Demo</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background: #f3f7fa;
  font-family: Arial, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
  color: #222;
}

.container {
  width: 100%;
  max-width: 390px;
  background: white;
  border-radius: 18px;
  padding: 30px 25px;
  text-align: center;
  box-shadow: 0 8px 30px #00000012;
}

.logo {
  width: 85px;
  height: 85px;
  border-radius: 50%;
  background: #229ed9;
  color: white;
  font-size: 45px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 auto 20px;
}

h1 {
  font-size: 25px;
  margin-bottom: 10px;
}

.subtitle {
  font-size: 14px;
  color: #777;
  line-height: 1.6;
  margin-bottom: 25px;
}

input, select {
  width: 100%;
  padding: 14px;
  border: 1px solid #d5dce2;
  border-radius: 9px;
  font-size: 16px;
  outline: none;
  margin-bottom: 15px;
  background: white;
}

input:focus, select:focus {
  border-color: #229ed9;
}

button {
  width: 100%;
  padding: 14px;
  border: none;
  border-radius: 9px;
  background: #229ed9;
  color: white;
  font-weight: bold;
  font-size: 15px;
  cursor: pointer;
}

button:hover {
  background: #168ac3;
}

.secondary {
  background: #e9f5fb;
  color: #168ac3;
  margin-top: 12px;
}

.hidden {
  display: none;
}

.notice {
  background: #fff6df;
  color: #72521a;
  border: 1px solid #f2dfac;
  border-radius: 9px;
  padding: 12px;
  font-size: 12px;
  line-height: 1.6;
  margin-bottom: 18px;
}

.message {
  margin-top: 15px;
  font-size: 14px;
  line-height: 1.6;
}

.demo-code {
  background: #eaf6fc;
  color: #168ac3;
  padding: 15px;
  font-size: 25px;
  font-weight: bold;
  letter-spacing: 8px;
  border-radius: 9px;
  margin: 18px 0;
}

.footer {
  margin-top: 25px;
  font-size: 11px;
  color: #999;
}
</style>
</head>

<body>

<div class="container">

  <div class="logo">➤</div>

  <h1>Telegram Login Demo</h1>

  <p class="subtitle">
    Educational simulation of a messaging-app login interface.
  </p>

  <div class="notice">
    ⚠️ DEMONSTRATION ONLY<br>
    This is not the official Telegram website.
    Never enter your real phone number, password or Telegram code.
  </div>

  <!-- PHONE SCREEN -->

  <section id="phoneScreen">

    <h3>Enter a demo number</h3>

    <p class="subtitle">
      Use a fictional number for this demonstration.
    </p>

    <select id="country">
      <option value="+251">Ethiopia (+251)</option>
      <option value="+1">USA (+1)</option>
      <option value="+44">UK (+44)</option>
      <option value="+91">India (+91)</option>
      <option value="+254">Kenya (+254)</option>
    </select>

    <input
      id="phone"
      type="tel"
      placeholder="Example: 900000000"
      maxlength="15"
      autocomplete="off"
    >

    <button onclick="startDemo()">
      Continue Demo
    </button>

  </section>

  <!-- DEMO VERIFICATION -->

  <section id="codeScreen" class="hidden">

    <h3>Demo verification</h3>

    <p class="subtitle">
      Your fictional demonstration code is shown below.
      It is generated locally and is not sent anywhere.
    </p>

    <div class="demo-code" id="generatedCode">
      00000
    </div>

    <input
      id="demoInput"
      type="text"
      inputmode="numeric"
      maxlength="5"
      placeholder="Enter demo code"
      autocomplete="off"
    >

    <button onclick="verifyDemo()">
      Verify Demo
    </button>

    <button class="secondary" onclick="goBack()">
      Back
    </button>

    <p class="message" id="message" aria-live="polite"></p>

  </section>

  <!-- SUCCESS SCREEN -->

  <section id="successScreen" class="hidden">

    <div style="font-size:55px">✅</div>

    <h2>Demo Completed!</h2>

    <p class="subtitle">
      You successfully completed the simulated login exercise.
      No Telegram account was accessed.
    </p>

    <button onclick="restartDemo()">
      Restart Demo
    </button>

  </section>

  <div class="footer">
    Independent cybersecurity education project.
    Not affiliated with Telegram.
  </div>

</div>

<script>

let generatedCode = "";

// Start the demonstration

function startDemo() {

  const phone = document.getElementById("phone").value.trim();

  if (!/^\d{6,15}$/.test(phone)) {
    alert("Enter a fictional demo number with 6–15 digits.");
    return;
  }

  // Generate a harmless local demo code

  generatedCode = String(
    Math.floor(10000 + Math.random() * 90000)
  );

  document.getElementById("generatedCode").textContent =
    generatedCode;

  document.getElementById("phoneScreen").classList.add("hidden");
  document.getElementById("codeScreen").classList.remove("hidden");

}

// Verify the demonstration code

function verifyDemo() {

  const entered = document.getElementById("demoInput").value.trim();

  const message = document.getElementById("message");

  if (entered === generatedCode) {

    document.getElementById("codeScreen").classList.add("hidden");
    document.getElementById("successScreen").classList.remove("hidden");

  } else {

    message.textContent =
      "Incorrect demo code. Check the displayed demonstration code.";

    message.style.color = "#d93025";

  }

}

// Go back

function goBack() {

  document.getElementById("codeScreen").classList.add("hidden");
  document.getElementById("phoneScreen").classList.remove("hidden");

}

// Restart

function restartDemo() {

  document.getElementById("successScreen").classList.add("hidden");
  document.getElementById("phoneScreen").classList.remove("hidden");

  document.getElementById("phone").value = "";
  document.getElementById("demoInput").value = "";
  document.getElementById("message").textContent = "";

  generatedCode = "";

}

</script>

</body>
</html>
